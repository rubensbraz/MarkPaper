# EditorConfig keeps formatting consistent across editors: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{js,html}]
indent_size = 2

[*.css]
indent_size = 4

[*.md]
# Trailing spaces are meaningful in Markdown (hard line breaks)
trim_trailing_whitespace = false
